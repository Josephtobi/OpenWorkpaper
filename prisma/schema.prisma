generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  password           String?
  role               String
  mustChangePassword Boolean  @default(false)
  ssoProvider        String?
  ssoId              String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  teamMembers        TeamMember[]
}

model Audit {
  id                      String       @id @default(uuid())
  title                   String
  description             String?
  category                String?
  auditNumber             String?
  objective               String?
  status                  String       @default("In Progress")
  pbcRequests             String?
  fieldworkStartDate      DateTime?
  fieldworkEndDate        DateTime?
  reportIssuedDate        DateTime?
  milestoneAttachmentUrl   String?
  milestoneAttachmentName  String?
  pbcAttachmentUrl         String?
  pbcAttachmentName        String?
  engagementAccepted       Boolean      @default(false)
  engagementLetterSigned   Boolean      @default(false)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  procedures              Procedure[]
  procedureGroups         ProcedureGroup[]
  teamMembers             TeamMember[]
  templateApplications    TemplateApplication[]
  stageProgress           AuditStageProgress[]
  stageOverrides          AuditStageOverride[]
  trialBalanceImports     TrialBalanceImport[]
  leadsheets              Leadsheet[]
  risks                   Risk[]
  materialityProfile      MaterialityProfile?
  samplingPlans           SamplingPlan[]
  misstatements           Misstatement[]
  opinion                 AuditOpinion?
}

model TeamMember {
  id        String   @id @default(uuid())
  auditId   String
  userId    String?
  name      String
  role      String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  audit              Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedProcedures Procedure[] @relation("ProcedureAssignment")
}

model Procedure {
  id           String       @id @default(uuid())
  auditId      String
  groupId      String?
  phase        String
  title        String?
  purpose      String?
  source       String?
  scope        String?
  methodology  String?
  results      String?
  conclusions  String?
  status       String       @default("Not Started")
  preparedBy   String?
  preparedDate DateTime?
  reviewedBy   String?
  reviewedDate DateTime?
  assignedToId String?
  leadsheetId  String?
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  attachments  Attachment[]
  messages     ProcedureMessage[]
  questions    ProcedureQuestion[]
  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  group        ProcedureGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignedTo   TeamMember? @relation("ProcedureAssignment", fields: [assignedToId], references: [id], onDelete: SetNull)
  leadsheet    Leadsheet?  @relation(fields: [leadsheetId], references: [id], onDelete: SetNull)
  bindings     FieldBinding[]
  assertions   ProcedureAssertion[]
  riskLinks    RiskProcedureLink[]
  misstatements Misstatement[]
}

model ProcedureGroup {
  id           String      @id @default(uuid())
  auditId      String
  phase        String      // Planning, Fieldwork, Reporting
  title        String
  displayOrder Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  audit        Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  procedures   Procedure[]
}

model ProcedureMessage {
  id          String    @id @default(uuid())
  procedureId String
  text        String
  sender      String    @default("Unknown")
  createdAt   DateTime  @default(now())
  
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
}

model Attachment {
  id            String    @id @default(uuid())
  procedureId   String
  filename      String
  filepath      String
  mimetype      String?
  size          Int?
  displayOrder  Int?
  preparedBy    String?
  preparedDate  DateTime?
  reviewedBy    String?
  reviewedDate  DateTime?
  createdAt     DateTime  @default(now())

  procedure     Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
}

model AuditTemplate {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  version     Int                 @default(1)
  groups      TemplateGroup[]
  procedures  TemplateProcedure[]
  applications TemplateApplication[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model TemplateGroup {
  id           String              @id @default(uuid())
  templateId   String
  phase        String              // Planning, Fieldwork, Reporting
  title        String
  displayOrder Int                 @default(0)
  procedures   TemplateProcedure[]
  
  template     AuditTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model TemplateProcedure {
  id           String        @id @default(uuid())
  templateId   String
  groupId      String?
  phase        String        // Planning, Fieldwork, Reporting
  title        String
  purpose      String?
  source       String?
  displayOrder Int          @default(0)
  questions    TemplateProcedureQuestion[]
  
  template     AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  group        TemplateGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model TemplateProcedureQuestion {
  id                    String                    @id @default(uuid())
  templateProcedureId   String
  prompt                String
  guidance              String?
  questionType          String                    @default("narrative")
  isRequired            Boolean                   @default(true)
  expectedEvidenceCount Int                       @default(0)
  expectedEvidenceTypes String?
  assertionTags         String?
  riskRating            String                    @default("Moderate")
  controlType           String                    @default("Substantive")
  displayOrder          Int                       @default(0)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  templateProcedure     TemplateProcedure         @relation(fields: [templateProcedureId], references: [id], onDelete: Cascade)
  citations             TemplateQuestionCitation[]
}

model TemplateQuestionCitation {
  id               String                    @id @default(uuid())
  templateQuestionId String
  standardType     String
  reference        String
  jurisdiction     String?
  displayOrder     Int                       @default(0)
  createdAt        DateTime                  @default(now())
  templateQuestion TemplateProcedureQuestion @relation(fields: [templateQuestionId], references: [id], onDelete: Cascade)
}

model ProcedureQuestion {
  id                    String                     @id @default(uuid())
  procedureId           String
  templateQuestionId    String?
  prompt                String
  guidance              String?
  questionType          String                     @default("narrative")
  isRequired            Boolean                    @default(true)
  expectedEvidenceCount Int                        @default(0)
  expectedEvidenceTypes String?
  assertionTags         String?
  riskRating            String                     @default("Moderate")
  controlType           String                     @default("Substantive")
  responseText          String?
  responseBoolean       Boolean?
  responseNumber        Float?
  responseDate          DateTime?
  responseSelection     String?
  exceptionFlag         Boolean                    @default(false)
  exceptionNarrative    String?
  validationStatus      String                     @default("Pending")
  reviewerStatus        String                     @default("Pending")
  displayOrder          Int                        @default(0)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  procedure             Procedure                  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  citations             ProcedureQuestionCitation[]
}

model ProcedureQuestionCitation {
  id                 String            @id @default(uuid())
  procedureQuestionId String
  standardType       String
  reference          String
  jurisdiction       String?
  displayOrder       Int               @default(0)
  createdAt          DateTime          @default(now())
  procedureQuestion  ProcedureQuestion @relation(fields: [procedureQuestionId], references: [id], onDelete: Cascade)
}

model TemplateApplication {
  id              String        @id @default(uuid())
  auditId         String
  templateId      String
  templateVersion Int
  appliedPhase    String?
  appliedBy       String?
  appliedAt       DateTime      @default(now())
  audit           Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  template        AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  details     String
  performedBy String?
  timestamp   DateTime @default(now())
}

enum EngagementStageKey {
  ACCEPTANCE
  UNDERSTANDING
  RISK
  MATERIALITY
  SAMPLING
  FIELDWORK
  COMPLETION
  OPINION
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum FsStatement {
  SOFP
  PROFIT_LOSS
  EQUITY
  CASHFLOW
}

enum BindType {
  LEADSHEET_TOTAL
  GROUPING_TOTAL
  ACCOUNT
  PRIOR_YEAR
}

enum RiskCategory {
  FRAUD
  ERROR
  GOING_CONCERN
  COMPLIANCE
  RELATED_PARTY
  ESTIMATE
}

enum RiskRating {
  HIGH
  MEDIUM
  LOW
}

enum Assertion {
  EXISTENCE
  COMPLETENESS
  VALUATION
  RIGHTS_OBLIGATIONS
  CUTOFF
  CLASSIFICATION
  PRESENTATION
  OCCURRENCE
  ACCURACY
}

model AuditStageProgress {
  id            String             @id @default(uuid())
  auditId        String
  stage          EngagementStageKey
  status         StageStatus        @default(NOT_STARTED)
  tailoringNotes String?
  completedAt    DateTime?
  completedBy    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  audit          Audit              @relation(fields: [auditId], references: [id], onDelete: Cascade)
  overrides      AuditStageOverride[]

  @@unique([auditId, stage])
  @@index([auditId, status])
}

model AuditStageOverride {
  id              String            @id @default(uuid())
  auditId          String
  stageProgressId  String
  gateCode         String
  gateMessage      String
  reason           String
  overriddenBy     String?
  createdAt        DateTime          @default(now())

  audit            Audit             @relation(fields: [auditId], references: [id], onDelete: Cascade)
  stageProgress    AuditStageProgress @relation(fields: [stageProgressId], references: [id], onDelete: Cascade)

  @@index([auditId, createdAt])
  @@index([stageProgressId])
}

model TrialBalanceImport {
  id            String               @id @default(uuid())
  auditId        String
  periodLabel    String
  isCurrentYear  Boolean              @default(true)
  source         String
  importedBy     String?
  importedAt     DateTime             @default(now())
  locked         Boolean              @default(false)
  accounts       TrialBalanceAccount[]
  audit          Audit                @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, periodLabel])
}

model TrialBalanceAccount {
  id            String            @id @default(uuid())
  importId       String
  accountCode    String
  accountName    String
  debit          Decimal           @default(0)
  credit         Decimal           @default(0)
  groupingId     String?
  import         TrialBalanceImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  grouping       Grouping?         @relation(fields: [groupingId], references: [id], onDelete: SetNull)
  bindings       FieldBinding[]    @relation("AccountBindings")

  @@index([importId])
  @@index([groupingId])
}

model Leadsheet {
  id          String        @id @default(uuid())
  auditId      String
  reference    String
  name         String
  fsCaption    String
  fsStatement  FsStatement
  groupings    Grouping[]
  procedures   Procedure[]
  bindings     FieldBinding[]
  samplingPlans SamplingPlan[]
  misstatements Misstatement[]
  audit        Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, reference])
  @@index([auditId, fsStatement])
}

model Grouping {
  id           String               @id @default(uuid())
  code         String
  name         String
  leadsheetId   String
  leadsheet     Leadsheet            @relation(fields: [leadsheetId], references: [id], onDelete: Cascade)
  accounts      TrialBalanceAccount[]
  bindings      FieldBinding[]

  @@unique([leadsheetId, code])
  @@index([leadsheetId])
}

model FieldBinding {
  id            String      @id @default(uuid())
  procedureId    String
  questionRef    String
  bindType       BindType
  leadsheetId    String?
  groupingId     String?
  accountId      String?
  cachedValue    Decimal?
  cachedAt       DateTime?
  procedure      Procedure   @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  leadsheet      Leadsheet?  @relation(fields: [leadsheetId], references: [id], onDelete: SetNull)
  grouping       Grouping?   @relation(fields: [groupingId], references: [id], onDelete: SetNull)
  account        TrialBalanceAccount? @relation("AccountBindings", fields: [accountId], references: [id], onDelete: SetNull)

  @@index([procedureId])
  @@index([leadsheetId])
  @@index([groupingId])
  @@index([accountId])
}

model Risk {
  id            String            @id @default(uuid())
  auditId        String
  reference      String
  description    String
  category       RiskCategory
  isSignificant  Boolean           @default(false)
  isPresumed     Boolean           @default(false)
  likelihood     RiskRating
  magnitude      RiskRating
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  audit          Audit             @relation(fields: [auditId], references: [id], onDelete: Cascade)
  assertions     RiskAssertion[]
  links          RiskProcedureLink[]
  samplingPlans  SamplingPlan[]

  @@unique([auditId, reference])
  @@index([auditId, isSignificant])
}

model RiskAssertion {
  id         String     @id @default(uuid())
  riskId      String
  assertion   Assertion
  risk        Risk       @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@unique([riskId, assertion])
}

model ProcedureAssertion {
  id           String     @id @default(uuid())
  procedureId   String
  assertion     Assertion
  procedure     Procedure  @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([procedureId, assertion])
}

model RiskProcedureLink {
  id           String    @id @default(uuid())
  riskId        String
  procedureId   String
  risk          Risk      @relation(fields: [riskId], references: [id], onDelete: Cascade)
  procedure     Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([riskId, procedureId])
  @@index([procedureId])
}

model MaterialityProfile {
  id                    String    @id @default(uuid())
  auditId                String    @unique
  benchmark              String
  benchmarkValue         Decimal   @default(0)
  percentage             Decimal   @default(0)
  overallMateriality     Decimal   @default(0)
  performanceMateriality Decimal   @default(0)
  trivialThreshold       Decimal   @default(0)
  specificMateriality    Decimal?
  notes                  String?
  updatedBy              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  audit                  Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model SamplingPlan {
  id                   String    @id @default(uuid())
  auditId               String
  leadsheetId           String?
  riskId                String?
  areaLabel             String
  populationValue       Decimal   @default(0)
  tolerableMisstatement Decimal   @default(0)
  expectedMisstatement  Decimal   @default(0)
  confidencePercent     Int       @default(95)
  reliabilityFactor     Decimal   @default(1)
  suggestedSampleSize   Int       @default(0)
  selectedSampleSize    Int       @default(0)
  overrideReason        String?
  status                String    @default("Draft")
  createdBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  audit                 Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  leadsheet             Leadsheet? @relation(fields: [leadsheetId], references: [id], onDelete: SetNull)
  risk                  Risk?     @relation(fields: [riskId], references: [id], onDelete: SetNull)

  @@index([auditId, areaLabel])
  @@index([riskId])
}

model Misstatement {
  id            String     @id @default(uuid())
  auditId        String
  procedureId    String?
  leadsheetId    String?
  accountLabel   String
  assertion      Assertion
  amount         Decimal    @default(0)
  direction      String     @default("UNDERSTATEMENT")
  isCorrected    Boolean    @default(false)
  description    String?
  createdBy      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  audit          Audit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  procedure      Procedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  leadsheet      Leadsheet? @relation(fields: [leadsheetId], references: [id], onDelete: SetNull)

  @@index([auditId, isCorrected])
  @@index([procedureId])
  @@index([leadsheetId])
}

model AuditOpinion {
  id                 String   @id @default(uuid())
  auditId             String   @unique
  opinionType         String
  basis               String?
  requiresModification Boolean @default(false)
  modifiedDecisionReason String?
  selectedBy          String?
  selectedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  audit               Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
}
